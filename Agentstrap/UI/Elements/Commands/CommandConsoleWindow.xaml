<Window x:Class="Agentstrap.UI.Elements.Commands.CommandConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agentstrap Command Console"
        Width="560"
        Height="620"
        MinWidth="500"
        MinHeight="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Agentstrap.ico"
        Background="#17191F">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Roblox Command Console" FontSize="21" FontWeight="SemiBold" Foreground="#F4F5F7" />
            <TextBlock Text="Uses the Roblox chat window and normal Windows keyboard input." Margin="0,4,0,0" Foreground="#A9AEB8" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandInput" MinHeight="38" Padding="10,8" VerticalContentAlignment="Center"
                     FontFamily="Consolas" FontSize="14" ToolTip="Example: /help or /w username hello"
                     KeyDown="CommandInput_KeyDown" />
            <Button x:Name="RunTestButton" Grid.Column="1" Content="Run / Test" Margin="8,0,0,0" Padding="14,6"
                    Click="RunTestButton_Click" />
        </Grid>

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,10">
            <Button x:Name="FindRobloxButton" Content="Find Roblox" Margin="0,0,4,4" Padding="8,7" Click="FindRobloxButton_Click" />
            <Button x:Name="FocusRobloxButton" Content="Focus Roblox" Margin="4,0,0,4" Padding="8,7" Click="FocusRobloxButton_Click" />
            <Button x:Name="CopyCommandButton" Content="Copy Command" Margin="0,4,4,0" Padding="8,7" Click="CopyCommandButton_Click" />
            <Button x:Name="SendSlashButton" Content="Send /" Margin="4,4,0,0" Padding="8,7" Click="SendSlashButton_Click" />
            <Button x:Name="SendPasteButton" Content="Send Ctrl+V" Margin="0,4,4,0" Padding="8,7" Click="SendPasteButton_Click" />
            <Button x:Name="SendEnterButton" Content="Send Enter" Margin="4,4,0,0" Padding="8,7" Click="SendEnterButton_Click" />
        </UniformGrid>

        <Button x:Name="FullTestButton" Grid.Row="3" Content="RUN FULL TEST" MinHeight="38" Margin="0,0,0,10"
                FontWeight="Bold" Click="FullTestButton_Click" />

        <GroupBox Grid.Row="4" Header="Debug log" Foreground="#E5E7EB" BorderBrush="#444956" Padding="8">
            <TextBox x:Name="DebugLogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Background="#111318" Foreground="#D5D9E0"
                     BorderThickness="0" />
        </GroupBox>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Waiting for command." VerticalAlignment="Center" Foreground="#A9AEB8" />
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" MinWidth="88" Padding="12,6"
                    Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
