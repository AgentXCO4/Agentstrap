<base:WpfUiWindow x:Class="Agentstrap.UI.Elements.Dialogs.LaunchMenuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Agentstrap.UI.Elements.Base"
        xmlns:models="clr-namespace:Agentstrap.UI.ViewModels"
        xmlns:resources="clr-namespace:Agentstrap.Resources"
        mc:Ignorable="d"
        Title="Agentstrap"
        MinWidth="720" MinHeight="480" Width="760" Height="520"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Padding="8" ShowMinimize="False" ShowMaximize="False"
                     Title="Agentstrap" Icon="pack://application:,,,/Agentstrap.ico"
                     CanMaximize="False" KeyboardNavigation.TabNavigation="None" />
        <Grid Grid.Row="1" Margin="30,20,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="32" Height="32" Margin="0,0,10,0"
                           Source="pack://application:,,,/Agentstrap.ico" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Agentstrap" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Version, Mode=OneTime}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Hyperlink Content="Help" NavigateUri="https://bloxstraplabs.com/wiki/" />
                    <ui:Hyperlink Content="About" Margin="16,0,0,0"
                                  Command="{Binding LaunchAboutCommand, Mode=OneTime}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="22"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Play24" FontSize="23"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="Roblox Player" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="Start Roblox using your Agentstrap settings."
                                       FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button Grid.Row="1" Content="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}"
                                   Icon="Play24" Appearance="Primary" HorizontalAlignment="Stretch"
                                   Height="46" Margin="0,22,0,0"
                                   Command="{Binding LaunchRobloxCommand, Mode=OneTime}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="More" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Button Height="76" Margin="0,0,0,10" Padding="14,10"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding LaunchRobloxStudioCommand, Mode=OneTime}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="WrenchScrewdriver20" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                                <TextBlock Text="{x:Static resources:Strings.LaunchMenu_LaunchRobloxStudio}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Open the Roblox editor" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Height="76" Padding="14,10" HorizontalContentAlignment="Stretch"
                            Command="{Binding LaunchSettingsCommand, Mode=OneTime}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                                <TextBlock Text="{x:Static resources:Strings.LaunchMenu_ConfigureSettings}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Configure Agentstrap" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2" Text="Choose an action to continue."
                       FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,16,0,0" />
        </Grid>
    </Grid>
</base:WpfUiWindow>
