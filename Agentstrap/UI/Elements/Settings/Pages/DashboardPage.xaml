<ui:UiPage x:Class="Agentstrap.UI.Elements.Settings.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:Agentstrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance models:DashboardViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="Dashboard" Scrollable="True">
    <StackPanel Margin="4,0,16,18">
        <TextBlock Text="Roblox status" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Current installation and recent launch information."
                   Margin="0,3,0,16" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Roblox Player" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RobloxInstallStatus}" Margin="0,10,0,2" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RobloxInstallDetails}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Refresh" Icon="ArrowClockwise20"
                               VerticalAlignment="Top" Command="{Binding RefreshInstallStatusCommand}" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Process priority" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProcessPriority}" Margin="0,10,0,2" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Applied when Agentstrap starts Roblox."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Padding="16" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Last launch" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding LastLaunchTime}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <TextBlock Text="{Binding LastLaunchStatus}" Margin="0,10,0,2" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LastLaunchDetails}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="A detected client startup log confirms the handoff; it does not indicate that Roblox entered a game."
                           Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <TextBlock Text="Tools" Margin="2,22,0,8" FontSize="16" FontWeight="SemiBold" />
        <WrapPanel>
            <ui:Button Content="Repair Roblox link" Icon="LinkToolbox20" Margin="0,0,8,8"
                       Command="{Binding RepairRobloxLinkCommand}" />
            <ui:Button Content="Roblox logs" Icon="DocumentSearch20" Margin="0,0,8,8"
                       Command="{Binding OpenRobloxLogsCommand}" />
            <ui:Button Content="Agentstrap logs" Icon="FolderOpen24" Margin="0,0,8,8"
                       Command="{Binding OpenAgentstrapLogsCommand}" />
        </WrapPanel>
    </StackPanel>
</ui:UiPage>
