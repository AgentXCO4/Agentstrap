<base:WpfUiWindow x:Class="Agentstrap.UI.Elements.Settings.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Agentstrap.UI.Elements.Settings.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:Agentstrap.UI.Elements.Base"
             xmlns:resources="clr-namespace:Agentstrap.Resources"
             xmlns:dmodels="clr-namespace:Agentstrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
             Title="Agentstrap"
             MinWidth="1050"
             MinHeight="680"
             Width="1280"
             Height="800"
             Background="{ui:ThemeResource ApplicationBackgroundBrush}"
             ExtendsContentIntoTitleBar="True"
             WindowBackdropType="Mica"
             WindowStartupLocation="CenterScreen"
             Closing="WpfUiWindow_Closing"
             Closed="WpfUiWindow_Closed"
             PreviewKeyDown="Window_PreviewKeyDown"
             Loaded="MainWindow_Loaded">

    <Window.Resources>
        <Style x:Key="AgentRailItemStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:Snackbar
            x:Name="AlreadyRunningSnackbar"
            Grid.RowSpan="2"
            Panel.ZIndex="20"
            Margin="200,0,200,24"
            Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}"
            Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}"
            Icon="Info20"
            Timeout="10000" />

        <ui:Snackbar
            x:Name="SettingsSavedSnackbar"
            Grid.RowSpan="2"
            Panel.ZIndex="19"
            Margin="200,0,200,24"
            Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}"
            Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}"
            Appearance="Success"
            Icon="CheckmarkCircle32"
            Timeout="3000" />

        <ui:TitleBar
            x:Name="RootTitleBar"
            Grid.Row="0"
            Padding="8"
            ForceShutdown="False"
            MinimizeToTray="False"
            UseSnapLayout="True"
            Title="Agentstrap"
            Icon="pack://application:,,,/Agentstrap.ico" />

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="226" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,18,0"
                    Padding="12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,4,2,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" Background="Transparent">
                            <Image Source="pack://application:,,,/Agentstrap.ico"
                                   Width="31" Height="31" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Agentstrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <ui:TextBox
                        x:Name="SettingsSearchBox"
                        Grid.Row="1"
                        Height="36"
                        Margin="0,0,0,12"
                        Padding="10,6"
                        PlaceholderText="Search settings  ·  Ctrl+K"
                        TextChanged="SettingsSearchBox_TextChanged" />

                    <TextBlock Grid.Row="2"
                               Text="SETTINGS"
                               Margin="7,0,0,7"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="9"
                               FontWeight="Bold" />

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SidebarNavigationPanel">
                            <RadioButton Style="{StaticResource AgentRailItemStyle}"
                                         GroupName="AgentstrapNavigation"
                                         Tag="dashboard"
                                         ToolTip="Overview"
                                         IsChecked="True"
                                         Checked="NavigationButton_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Home24" FontSize="18"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Grid.Column="1" Text="Overview"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource AgentRailItemStyle}"
                                         GroupName="AgentstrapNavigation"
                                         Tag="integrations"
                                         ToolTip="{x:Static resources:Strings.Menu_Integrations_Title}"
                                         Checked="NavigationButton_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Add28" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_Integrations_Title}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource AgentRailItemStyle}"
                                         GroupName="AgentstrapNavigation"
                                         Tag="deployments"
                                         ToolTip="Deployments"
                                         Checked="NavigationButton_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="PlaySettings20" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Grid.Column="1" Text="Deployments" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource AgentRailItemStyle}"
                                         GroupName="AgentstrapNavigation"
                                         Tag="mods"
                                         ToolTip="{x:Static resources:Strings.Menu_Mods_Title}"
                                         Checked="NavigationButton_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="WrenchScrewdriver20" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_Mods_Title}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource AgentRailItemStyle}"
                                         GroupName="AgentstrapNavigation"
                                         Tag="fastflags"
                                         ToolTip="{x:Static resources:Strings.Menu_FastFlags_Title}"
                                         Checked="NavigationButton_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Flag24" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_FastFlags_Title}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource AgentRailItemStyle}"
                                         GroupName="AgentstrapNavigation"
                                         Tag="appearance"
                                         ToolTip="{x:Static resources:Strings.Menu_Appearance_Title}"
                                         Checked="NavigationButton_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="PaintBrush24" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_Appearance_Title}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource AgentRailItemStyle}"
                                         GroupName="AgentstrapNavigation"
                                         Tag="shortcuts"
                                         ToolTip="{x:Static resources:Strings.Common_Shortcuts}"
                                         Checked="NavigationButton_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Apps28" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Common_Shortcuts}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource AgentRailItemStyle}"
                                         GroupName="AgentstrapNavigation"
                                         Tag="agentstrap"
                                         ToolTip="Agentstrap settings"
                                         Checked="NavigationButton_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Grid.Column="1" Text="Agentstrap settings" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="4"
                            Margin="0,10,0,0"
                            Padding="8,10"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Options"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:ToggleSwitch IsChecked="{Binding TestModeEnabled, Mode=TwoWay}" />
                                <TextBlock Text="Test mode" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,2,4,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentSectionTitle"
                                   Text="Overview"
                                   FontSize="24" FontWeight="SemiBold"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="Launch Roblox"
                               Icon="Play24"
                               Appearance="Primary"
                               MinWidth="164"
                               Height="42"
                               Command="{Binding LaunchRobloxCommand, Mode=OneWay}" />
                </Grid>

                <Border Grid.Row="1"
                        Padding="16,10"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <Frame x:Name="RootFrame"
                           Background="Transparent"
                           NavigationUIVisibility="Hidden" />
                </Border>

                <Border Grid.Row="2"
                        Margin="4,16,4,0"
                         Padding="4,8"
                         Background="Transparent"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                         BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#62D6A6" />
                            <TextBlock Text="Agentstrap ready"
                                       Margin="9,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{x:Static resources:Strings.Menu_About_Title}"
                                Margin="4,0"
                                Padding="14,7"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding OpenAboutCommand, Mode=OneWay}" />
                        <ui:Button Grid.Column="2"
                                   Content="{x:Static resources:Strings.Menu_Save}"
                                   
                                   Margin="4,0"
                                   Command="{Binding SaveSettingsCommand, Mode=OneWay}" />
                        <ui:Button Grid.Column="3"
                                   Content="{x:Static resources:Strings.Common_Close}"
                                   Margin="4,0,0,0"
                                   Command="{Binding CloseWindowCommand, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <ui:NavigationFluent
            x:Name="RootNavigation"
            Grid.Row="1"
            Visibility="Collapsed"
            Frame="{Binding ElementName=RootFrame}"
            SelectedPageIndex="0">
            <ui:NavigationFluent.Items>
                <ui:NavigationItem Content="Overview" PageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Integrations_Title}" PageType="{x:Type pages:IntegrationsPage}" />
                <ui:NavigationItem Content="Deployments" PageType="{x:Type pages:DeploymentPage}" />
                <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Mods_Title}" PageType="{x:Type pages:ModsPage}" />
                <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlags_Title}" PageType="{x:Type pages:FastFlagsPage}" />
                <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Appearance_Title}" PageType="{x:Type pages:AppearancePage}" />
                <ui:NavigationItem Content="{x:Static resources:Strings.Common_Shortcuts}" PageType="{x:Type pages:ShortcutsPage}" />
                <ui:NavigationItem Content="Agentstrap settings" PageType="{x:Type pages:BloxstrapPage}" />
                <ui:NavigationItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" PageType="{x:Type pages:FastFlagEditorPage}" />
            </ui:NavigationFluent.Items>
        </ui:NavigationFluent>
    </Grid>
</base:WpfUiWindow>
